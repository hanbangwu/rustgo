# The backend alone, for hosts like Render where the frontend is deployed separately.
# Tests are left to CI so builds stay within the free build minutes.
FROM rust:alpine AS backend
WORKDIR /src
RUN apk add --no-cache musl-dev
COPY Cargo.toml Cargo.lock ./
COPY igo-core igo-core
COPY igo-server igo-server
RUN cargo build --release -p igo-server

FROM scratch
COPY --from=backend /src/target/release/igo-server /igo-server
USER 1000:1000
CMD ["/igo-server"]
